# =================================================================
# DeliveryCity — Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA commite o .env.local com valores reais no repositório!
# =================================================================

# Supabase — crie seu projeto em https://supabase.com
VITE_SUPABASE_URL=https://SEU_PROJETO_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase_aqui

# Google Maps API (restrinja no Google Cloud Console ao seu domínio e app)
VITE_GOOGLE_MAPS_API_KEY=sua_google_maps_api_key

# PagSeguro (chave pública, não a chave secreta)
VITE_PAGSEGURO_PUBLIC_KEY=sua_pagseguro_public_key
VITE_PAGSEGURO_PLATFORM_RECIPIENT_ID=seu_recipient_id

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com

# Contato de suporte (número WhatsApp)
VITE_SUPPORT_PHONE=(00) 00000-0000
